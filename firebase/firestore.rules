rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(lid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/leagues/$(lid)).data.members;
    }

    // 내 구단 저장 데이터: 본인만 읽고 쓰기
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // 저장 데이터 하위 문서(owned·team·rest): 본인만
      match /save/{part} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // 직접 올린 선수 사진(기기 간 연동): 본인만, 사진 1장 200KB 미만
      match /photos/{pid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.d is string && request.resource.data.d.size() < 200000;
      }
    }

    // 쿠폰: 코드(문서 id)를 정확히 알 때만 읽기. 목록 조회·쓰기는 막음(쿠폰은 Firebase 콘솔에서 직접 추가)
    // 문서 예: coupons/OPENING2026 = { pt: 5000, tix: {prem: 1}, exp: <timestamp>, note: '오픈 기념' }
    match /coupons/{code} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // 친구 리그
    match /leagues/{lid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // 리그장은 수정 가능, 그 외에는 자기 자신을 멤버로 한 명 추가하는 것만 허용
      allow update: if signedIn() && (
        resource.data.owner == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // 각 멤버가 공개한 라인업 (상대가 시뮬레이션에 사용)
      match /teams/{uid} {
        allow read: if isMember(lid);
        allow write: if isMember(lid) && request.auth.uid == uid;
      }
      // 경기 결과 기록
      match /games/{gid} {
        allow read: if isMember(lid);
        allow create: if isMember(lid) && request.resource.data.by == request.auth.uid;
      }
    }
  }
}
